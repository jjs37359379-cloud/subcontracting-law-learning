# 국가법령정보 공동활용 인증값
LAW_API_OC=발급받은_OC

# Gmail 자동발송 설정 — 실제 비밀번호는 이 예시 파일에 저장하지 마세요.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@gmail.com
SMTP_PASS=앱_비밀번호_또는_SMTP_토큰
MAIL_FROM=바른구매 법령알림 <sender@gmail.com>
MAIL_TO=recipient@company.com
TRAINING_SITE_URL=https://jjs37359379-cloud.github.io/subcontracting-law-learning/
# 비워 두면 사이트 주소를 기준으로 PDF 주소를 자동 생성합니다.
TRAINING_PDF_URL=
